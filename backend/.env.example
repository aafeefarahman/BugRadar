# BugRadar Environment Configuration Example
# Copy this file to .env and configure your secrets

# GitHub Personal Access Token (Raises API rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Google Gemini API Key (For AI code remediation and fix suggestions)
GEMINI_API_KEY=

# Database Connection (SQLite default for local, PostgreSQL on Render/Supabase)
DATABASE_URL=sqlite:///./bugradar.db

# JWT Secret Key
SECRET_KEY=your_random_secret_key_here
